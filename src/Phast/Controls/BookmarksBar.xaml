<UserControl x:Class="Phast.Controls.BookmarksBar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border Background="{DynamicResource ToolbarBrush}" BorderBrush="{DynamicResource ToolbarSeparatorBrush}"
            BorderThickness="0,0,0,1" Height="34" Padding="8,0" MouseRightButtonUp="Bar_MouseRightButtonUp">
        <DockPanel x:Name="Dock" LastChildFill="True">
            <!-- "Other bookmarks" folder, at the far right like Chrome -->
            <StackPanel x:Name="OtherArea" DockPanel.Dock="Right" Orientation="Horizontal">
                <Rectangle Width="1" Height="18" Margin="4,0,6,0" Fill="{DynamicResource ToolbarSeparatorBrush}"/>
                <Button x:Name="OtherButton" Style="{StaticResource BookmarkButton}" Click="Other_Click"/>
            </StackPanel>
            <!-- Overflow chevron with the items that don't fit -->
            <Button x:Name="ChevronButton" DockPanel.Dock="Right" Style="{StaticResource BookmarkButton}" Visibility="Collapsed"
                    Click="Chevron_Click" ToolTip="Más marcadores">
                <TextBlock Text="»" FontSize="16" Margin="0,-3,0,0" Foreground="{DynamicResource IconBrush}"/>
            </Button>
            <StackPanel x:Name="ItemsHost" Orientation="Horizontal" ClipToBounds="True"/>
        </DockPanel>
    </Border>
</UserControl>
