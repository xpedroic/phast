<UserControl x:Class="Phast.Controls.AdblockBubble"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="320">
    <Border Background="{DynamicResource MenuBrush}" BorderBrush="{DynamicResource MenuBorderBrush}" BorderThickness="1"
            CornerRadius="12" Padding="20,16" Margin="8,4,8,12">
        <Border.Effect>
            <DropShadowEffect BlurRadius="16" ShadowDepth="3" Opacity="0.3"/>
        </Border.Effect>
        <StackPanel>
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="&#xEA18;" FontFamily="{StaticResource IconFont}" FontSize="16"
                           Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center"/>
                <TextBlock Text="Bloqueador de anuncios" FontSize="15" Margin="10,0,0,0" VerticalAlignment="Center"
                           Foreground="{DynamicResource TextBrush}"/>
            </StackPanel>
            <TextBlock x:Name="HostText" FontSize="12" Margin="26,4,0,0" Foreground="{DynamicResource TextSecondaryBrush}"
                       TextTrimming="CharacterEllipsis"/>

            <StackPanel x:Name="CountPanel" Orientation="Horizontal" Margin="0,18,0,0">
                <TextBlock x:Name="CountText" FontSize="34" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}"/>
                <TextBlock x:Name="CountLabel" FontSize="13" Margin="10,0,0,7" VerticalAlignment="Bottom"
                           Foreground="{DynamicResource TextSecondaryBrush}"/>
            </StackPanel>
            <TextBlock x:Name="StatusText" FontSize="13" Margin="0,14,0,0" TextWrapping="Wrap"
                       Foreground="{DynamicResource TextSecondaryBrush}" Visibility="Collapsed"/>

            <Border Height="1" Margin="0,16" Background="{DynamicResource ToolbarSeparatorBrush}"/>

            <DockPanel x:Name="SiteRow">
                <CheckBox x:Name="SiteToggle" DockPanel.Dock="Right" Style="{StaticResource ToggleSwitch}" VerticalAlignment="Center"
                          Click="SiteToggle_Click"/>
                <StackPanel>
                    <TextBlock Text="Bloquear en este sitio" FontSize="13" Foreground="{DynamicResource TextBrush}"/>
                    <TextBlock Text="Al cambiarlo se recarga la página" FontSize="11" Margin="0,2,0,0"
                               Foreground="{DynamicResource TextSecondaryBrush}"/>
                </StackPanel>
            </DockPanel>

            <Button Content="Ajustes del bloqueador" Style="{StaticResource LinkButton}" Margin="0,16,0,0"
                    HorizontalAlignment="Left" Click="Settings_Click"/>
        </StackPanel>
    </Border>
</UserControl>
