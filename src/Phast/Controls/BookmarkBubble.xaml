<UserControl x:Class="Phast.Controls.BookmarkBubble"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="360">
    <Border Background="{DynamicResource MenuBrush}" BorderBrush="{DynamicResource MenuBorderBrush}" BorderThickness="1"
            CornerRadius="12" Padding="20,16" Margin="8,4,8,12">
        <Border.Effect>
            <DropShadowEffect BlurRadius="16" ShadowDepth="3" Opacity="0.3"/>
        </Border.Effect>
        <StackPanel>
            <TextBlock x:Name="Heading" FontSize="16" Foreground="{DynamicResource TextBrush}" Margin="0,0,0,14"/>

            <TextBlock Text="Nombre" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4"/>
            <TextBox x:Name="NameBox" Style="{StaticResource FormTextBox}" KeyDown="Box_KeyDown"/>

            <StackPanel x:Name="UrlPanel">
                <TextBlock Text="URL" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,12,0,4"/>
                <TextBox x:Name="UrlBox" Style="{StaticResource FormTextBox}" KeyDown="Box_KeyDown"/>
            </StackPanel>

            <StackPanel x:Name="FolderPanel">
                <TextBlock Text="Carpeta" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,12,0,4"/>
                <ComboBox x:Name="FolderBox" Style="{StaticResource FormComboBox}"/>
            </StackPanel>

            <DockPanel Margin="0,20,0,0" LastChildFill="False">
                <Button x:Name="SecondaryAction" DockPanel.Dock="Left" Style="{StaticResource SecondaryButton}" Click="Secondary_Click"/>
                <Button x:Name="PrimaryAction" DockPanel.Dock="Right" Style="{StaticResource PrimaryButton}" Click="Primary_Click"/>
            </DockPanel>
        </StackPanel>
    </Border>
</UserControl>
