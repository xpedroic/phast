<Window x:Class="Phast.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:controls="clr-namespace:Phast.Controls"
        xmlns:tabs="clr-namespace:Phast.Tabs"
        Title="Phast" Width="1280" Height="800" MinWidth="500" MinHeight="300"
        Background="{DynamicResource FrameBrush}"
        FontFamily="{StaticResource UiFont}"
        UseLayoutRounding="True"
        Icon="pack://application:,,,/Assets/phast.ico">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="41" ResizeBorderThickness="6"
                            GlassFrameThickness="0,0,0,1" CornerRadius="0" UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <controls:NullToVisibleConverter x:Key="NullToVisible"/>
        <controls:NotNullToVisibleConverter x:Key="NotNullToVisible"/>

        <!-- One tab in the tab strip. -->
        <DataTemplate DataType="{x:Type tabs:BrowserTab}">
            <Grid x:Name="TabRoot" Height="34" Background="Transparent" ToolTip="{Binding DisplayTitle}"
                  shell:WindowChrome.IsHitTestVisibleInChrome="True"
                  MouseLeftButtonDown="Tab_MouseLeftButtonDown" MouseUp="Tab_MouseUp" MouseRightButtonUp="Tab_MouseRightButtonUp">
                <Border x:Name="Shape" CornerRadius="8,8,0,0" Background="Transparent" Margin="0,0,0,0"/>
                <!-- Concave "feet" that connect the active tab with the toolbar, like Chrome. -->
                <Path x:Name="FootLeft" Data="M0,8 A8,8 0 0 0 8,0 L8,8 Z" Width="8" Height="8" Margin="-8,0,0,0"
                      HorizontalAlignment="Left" VerticalAlignment="Bottom" Fill="{DynamicResource ToolbarBrush}" Visibility="Collapsed"/>
                <Path x:Name="FootRight" Data="M0,0 A8,8 0 0 0 8,8 L0,8 Z" Width="8" Height="8" Margin="0,0,-8,0"
                      HorizontalAlignment="Right" VerticalAlignment="Bottom" Fill="{DynamicResource ToolbarBrush}" Visibility="Collapsed"/>
                <!-- Colored line under the tabs of a group -->
                <Rectangle Height="2" VerticalAlignment="Bottom" Margin="6,0,6,0" RadiusX="1" RadiusY="1"
                           Fill="{Binding Group.Brush}" Visibility="{Binding Group, Converter={StaticResource NotNullToVisible}}"/>
                <Rectangle Width="1" Height="18" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,0,0"
                           Fill="{DynamicResource TabSeparatorBrush}" Opacity="0.6"
                           Visibility="{Binding ShowSeparator, Converter={StaticResource BoolToVis}}"/>

                <Grid Margin="12,0,6,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Grid Width="16" Height="16" VerticalAlignment="Center">
                        <Image x:Name="Favicon" Source="{Binding Favicon}" RenderOptions.BitmapScalingMode="HighQuality"
                               Visibility="{Binding Favicon, Converter={StaticResource NotNullToVisible}}"/>
                        <TextBlock x:Name="Globe" Text="&#xE774;" FontFamily="{StaticResource IconFont}" FontSize="14"
                                   Foreground="{DynamicResource IconBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Visibility="{Binding Favicon, Converter={StaticResource NullToVisible}}"/>
                        <Path x:Name="Spinner" Data="M8,1.5 A6.5,6.5 0 1 1 1.5,8" Stroke="{DynamicResource AccentBrush}"
                              StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                              Visibility="Collapsed" RenderTransformOrigin="0.5,0.5" Width="16" Height="16">
                            <Path.RenderTransform>
                                <RotateTransform Angle="0"/>
                            </Path.RenderTransform>
                        </Path>
                    </Grid>

                    <TextBlock Grid.Column="1" Text="{Binding DisplayTitle}" Margin="8,0,4,1" VerticalAlignment="Center"
                               FontSize="12" Foreground="{DynamicResource TextBrush}" TextTrimming="CharacterEllipsis"/>

                    <Button x:Name="AudioButton" Grid.Column="2" Style="{StaticResource TabCloseButton}" FontSize="11"
                            Content="&#xE767;" Click="TabAudio_Click" Visibility="Collapsed" ToolTip="Silenciar pestaña"/>

                    <Button Grid.Column="3" Style="{StaticResource TabCloseButton}" Content="&#xE8BB;"
                            Click="TabClose_Click" ToolTip="Cerrar pestaña (Ctrl+W)"/>
                </Grid>
            </Grid>
            <DataTemplate.Triggers>
                <Trigger SourceName="TabRoot" Property="IsMouseOver" Value="True">
                    <Setter TargetName="Shape" Property="Background" Value="{DynamicResource TabHoverBrush}"/>
                    <Setter TargetName="Shape" Property="Margin" Value="0,2,0,2"/>
                    <Setter TargetName="Shape" Property="CornerRadius" Value="8"/>
                </Trigger>
                <DataTrigger Binding="{Binding IsActive}" Value="True">
                    <Setter TargetName="Shape" Property="Background" Value="{DynamicResource ToolbarBrush}"/>
                    <Setter TargetName="Shape" Property="Margin" Value="0"/>
                    <Setter TargetName="Shape" Property="CornerRadius" Value="8,8,0,0"/>
                    <Setter TargetName="FootLeft" Property="Visibility" Value="Visible"/>
                    <Setter TargetName="FootRight" Property="Visibility" Value="Visible"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding IsAudible}" Value="True">
                    <Setter TargetName="AudioButton" Property="Visibility" Value="Visible"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding IsMuted}" Value="True">
                    <Setter TargetName="AudioButton" Property="Visibility" Value="Visible"/>
                    <Setter TargetName="AudioButton" Property="Content" Value="&#xE74F;"/>
                    <Setter TargetName="AudioButton" Property="ToolTip" Value="Activar sonido"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding IsLoading}" Value="True">
                    <Setter TargetName="Spinner" Property="Visibility" Value="Visible"/>
                    <Setter TargetName="Favicon" Property="Opacity" Value="0"/>
                    <Setter TargetName="Globe" Property="Opacity" Value="0"/>
                    <DataTrigger.EnterActions>
                        <BeginStoryboard x:Name="Spin">
                            <Storyboard RepeatBehavior="Forever">
                                <DoubleAnimation Storyboard.TargetName="Spinner"
                                                 Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)"
                                                 From="0" To="360" Duration="0:0:0.9"/>
                            </Storyboard>
                        </BeginStoryboard>
                    </DataTrigger.EnterActions>
                    <DataTrigger.ExitActions>
                        <StopStoryboard BeginStoryboardName="Spin"/>
                    </DataTrigger.ExitActions>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- Tab group label ("chip"): click to collapse/expand, right click for options. -->
        <DataTemplate DataType="{x:Type tabs:TabGroup}">
            <Button Height="34" Cursor="Hand" ToolTip="{Binding Name}" Focusable="False"
                    AutomationProperties.AutomationId="GroupChip" AutomationProperties.Name="{Binding Name}"
                    shell:WindowChrome.IsHitTestVisibleInChrome="True"
                    Click="GroupChip_Click" MouseRightButtonUp="GroupChip_MouseRightButtonUp">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <ContentPresenter Margin="6,0,4,2" VerticalAlignment="Center"/>
                    </ControlTemplate>
                </Button.Template>
                <Border x:Name="Chip" Background="{Binding Brush}" CornerRadius="6" Height="22" MinWidth="14" Padding="8,0">
                    <TextBlock x:Name="ChipText" Text="{Binding Name}" Foreground="{Binding Foreground}" FontSize="12" FontWeight="SemiBold"
                               VerticalAlignment="Center" MaxWidth="160" TextTrimming="CharacterEllipsis"/>
                </Border>
            </Button>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Name}" Value="">
                    <Setter TargetName="Chip" Property="Width" Value="14"/>
                    <Setter TargetName="Chip" Property="Height" Value="14"/>
                    <Setter TargetName="Chip" Property="Padding" Value="0"/>
                    <Setter TargetName="Chip" Property="CornerRadius" Value="7"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding IsCollapsed}" Value="True">
                    <Setter TargetName="Chip" Property="Opacity" Value="0.85"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </Window.Resources>

    <Grid x:Name="RootGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ===== Title bar with tabs ===== -->
        <Grid x:Name="TitleBar" Grid.Row="0" Height="41">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel x:Name="TabArea" Orientation="Horizontal" VerticalAlignment="Bottom" Margin="8,0,0,0">
                <ItemsControl x:Name="TabsList" Focusable="False">
                    <!-- Tabs of a collapsed group are hidden -->
                    <ItemsControl.ItemContainerStyle>
                        <Style TargetType="ContentPresenter">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Group.IsCollapsed, FallbackValue=False}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ItemsControl.ItemContainerStyle>
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <controls:TabStripPanel/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>
                <Button x:Name="NewTabButton" Style="{StaticResource NewTabButton}" Content="&#xE710;"
                        VerticalAlignment="Center" Margin="6,0,0,2" Click="NewTab_Click" ToolTip="Nueva pestaña (Ctrl+T)"/>
            </StackPanel>

            <StackPanel x:Name="CaptionButtons" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top" Height="34">
                <Button Style="{StaticResource CaptionButton}" Content="&#xE921;" Click="Minimize_Click" ToolTip="Minimizar"/>
                <Button x:Name="MaximizeButton" Style="{StaticResource CaptionButton}" Content="&#xE922;" Click="Maximize_Click"/>
                <Button Style="{StaticResource CaptionCloseButton}" Content="&#xE8BB;" Click="CloseWindow_Click" ToolTip="Cerrar"/>
            </StackPanel>
        </Grid>

        <!-- ===== Toolbar: navigation, address bar, actions, menu ===== -->
        <Border x:Name="Toolbar" Grid.Row="1" Background="{DynamicResource ToolbarBrush}"
                BorderBrush="{DynamicResource ToolbarSeparatorBrush}" BorderThickness="0,0,0,1">
            <DockPanel Height="46" Margin="6,0,8,0" LastChildFill="True">
                <Button x:Name="BackButton" DockPanel.Dock="Left" Style="{StaticResource ToolbarButton}" Content="&#xE72B;"
                        Click="Back_Click" ToolTip="Atrás (Alt+←)" IsEnabled="False"/>
                <Button x:Name="ForwardButton" DockPanel.Dock="Left" Style="{StaticResource ToolbarButton}" Content="&#xE72A;"
                        Click="Forward_Click" ToolTip="Adelante (Alt+→)" IsEnabled="False"/>
                <Button x:Name="ReloadButton" DockPanel.Dock="Left" Style="{StaticResource ToolbarButton}" Content="&#xE72C;"
                        Click="Reload_Click" ToolTip="Recargar (F5)"/>

                <!-- Three-dot menu -->
                <Button x:Name="MenuButton" DockPanel.Dock="Right" Style="{StaticResource ToolbarButton}"
                        Click="Menu_Click" ToolTip="Personalizar y controlar Phast">
                    <StackPanel>
                        <Ellipse Width="3.5" Height="3.5" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Margin="0,1"/>
                        <Ellipse Width="3.5" Height="3.5" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Margin="0,1"/>
                        <Ellipse Width="3.5" Height="3.5" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Margin="0,1"/>
                    </StackPanel>
                </Button>

                <!-- Extension / action icons will live here. -->
                <StackPanel x:Name="ActionsBar" DockPanel.Dock="Right" Orientation="Horizontal">
                    <!-- Downloads: only visible once something was downloaded in this run; ring = progress -->
                    <Button x:Name="DownloadsButton" Style="{StaticResource ToolbarButton}" Click="Downloads_Click"
                            ToolTip="Descargas (Ctrl+J)" Visibility="Collapsed">
                        <Grid Width="34" Height="34">
                            <TextBlock Text="&#xE896;" FontSize="15" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            <Ellipse x:Name="DownloadRing" Width="26" Height="26" StrokeThickness="2" Stroke="{DynamicResource AccentBrush}"
                                     RenderTransformOrigin="0.5,0.5" Visibility="Collapsed">
                                <Ellipse.RenderTransform><RotateTransform Angle="-90"/></Ellipse.RenderTransform>
                            </Ellipse>
                        </Grid>
                    </Button>
                    <!-- Saved page groups ("Trabajo", "Ocio"...) -->
                    <Button x:Name="PageGroupsButton" Style="{StaticResource ToolbarButton}" Content="&#xE71D;" Click="PageGroups_Click"
                            ToolTip="Grupos de páginas"/>
                    <!-- Instant dark mode for the current site -->
                    <Button x:Name="DarkButton" Style="{StaticResource ToolbarButton}" Content="&#xE708;" Click="Dark_Click"
                            ToolTip="Modo oscuro en esta web (Ctrl+Mayús+D)"/>
                    <!-- Ad blocker: shield with the number of blocked requests on this page -->
                    <Button x:Name="ShieldButton" Style="{StaticResource ToolbarButton}" Click="Shield_Click"
                            ToolTip="Bloqueador de anuncios">
                        <Grid Width="34" Height="34">
                            <TextBlock x:Name="ShieldGlyph" Text="&#xEA18;" FontSize="15"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            <Border x:Name="ShieldBadge" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                    Margin="0,0,1,5" MinWidth="15" Height="14" CornerRadius="7" Padding="3,0"
                                    Background="{DynamicResource AccentBrush}" Visibility="Collapsed">
                                <TextBlock x:Name="ShieldCount" FontFamily="{StaticResource UiFont}" FontSize="9" FontWeight="SemiBold"
                                           Foreground="{DynamicResource ContentBackgroundBrush}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </Grid>
                    </Button>
                </StackPanel>

                <!-- Address bar ("omnibox") -->
                <Border x:Name="Omnibox" Height="36" CornerRadius="18" Margin="6,0" BorderThickness="2">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Background" Value="{DynamicResource OmniboxBrush}"/>
                            <Setter Property="BorderBrush" Value="Transparent"/>
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="{DynamicResource OmniboxHoverBrush}"/>
                                </Trigger>
                                <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                    <Setter Property="Background" Value="{DynamicResource OmniboxFocusBrush}"/>
                                    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <DockPanel Margin="4,0">
                        <Button x:Name="SiteInfoButton" DockPanel.Dock="Left" Style="{StaticResource OmniboxButton}"
                                Content="&#xE721;" ToolTip="Información del sitio"/>
                        <Button x:Name="StarButton" DockPanel.Dock="Right" Style="{StaticResource OmniboxButton}"
                                Content="&#xE734;" ToolTip="Añadir a marcadores (Ctrl+D)" Click="Star_Click"/>
                        <TextBox x:Name="AddressBox" Style="{StaticResource OmniboxTextBox}" Margin="4,0"
                                 KeyDown="AddressBox_KeyDown" GotKeyboardFocus="AddressBox_GotKeyboardFocus"
                                 LostKeyboardFocus="AddressBox_LostKeyboardFocus"
                                 PreviewMouseLeftButtonDown="AddressBox_PreviewMouseLeftButtonDown"/>
                    </DockPanel>
                </Border>
            </DockPanel>
        </Border>

        <!-- ===== Web content: one WebView2 per loaded tab, stacked; only the active one is visible ===== -->
        <Grid x:Name="WebHost" Grid.Row="3" Background="{DynamicResource ContentBackgroundBrush}"/>

        <!-- ===== Bookmarks bar ===== -->
        <controls:BookmarksBar x:Name="BookmarksBar" Grid.Row="2"/>

        <!-- ===== "Bookmark added" / edit bubble ===== -->
        <Popup x:Name="BubblePopup" StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade">
            <controls:BookmarkBubble x:Name="Bubble"/>
        </Popup>

        <!-- ===== Ad blocker bubble (shield button) ===== -->
        <Popup x:Name="AdblockPopup" StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade">
            <controls:AdblockBubble x:Name="AdblockPanel"/>
        </Popup>

        <!-- ===== Address bar suggestions dropdown (a Popup, so it floats above the web page) ===== -->
        <Popup x:Name="SuggestPopup" PlacementTarget="{Binding ElementName=Omnibox}" Placement="Bottom"
               VerticalOffset="4" HorizontalOffset="-8" AllowsTransparency="True" StaysOpen="True"
               Focusable="False" PopupAnimation="None">
            <Border Background="{DynamicResource MenuBrush}" BorderBrush="{DynamicResource MenuBorderBrush}"
                    BorderThickness="1" CornerRadius="12" Padding="0,6" Margin="8,0,8,10"
                    Width="{Binding ActualWidth, ElementName=Omnibox}">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="12" ShadowDepth="2" Opacity="0.25"/>
                </Border.Effect>
                <ItemsControl x:Name="SuggestList" Focusable="False">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border x:Name="Row" Height="36" Background="Transparent" Cursor="Hand"
                                    MouseEnter="Suggestion_MouseEnter" MouseLeftButtonDown="Suggestion_MouseDown"
                                    MouseUp="Suggestion_MouseUp">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="44"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Glyph}" FontFamily="{StaticResource IconFont}" FontSize="14"
                                               Foreground="{DynamicResource IconBrush}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                               FontSize="14" Margin="0,0,16,0">
                                        <Run Text="{Binding Text, Mode=OneWay}" Foreground="{DynamicResource TextBrush}"/><Run
                                             x:Name="Dash" Text=" – " Foreground="{DynamicResource TextSecondaryBrush}"/><Run
                                             x:Name="DetailRun" Text="{Binding Detail, Mode=OneWay}" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                    </TextBlock>
                                </Grid>
                            </Border>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                    <Setter TargetName="Row" Property="Background" Value="{DynamicResource MenuHoverBrush}"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Detail}" Value="{x:Null}">
                                    <Setter TargetName="Dash" Property="Text" Value=""/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding DetailIsUrl}" Value="True">
                                    <Setter TargetName="DetailRun" Property="Foreground" Value="{DynamicResource AccentBrush}"/>
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Border>
        </Popup>
    </Grid>
</Window>
