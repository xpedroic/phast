<!-- Dark palette, modeled on Chrome's default dark theme. Keys must match Light.xaml. -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <SolidColorBrush x:Key="FrameBrush" Color="#202124"/>
    <SolidColorBrush x:Key="FrameInactiveBrush" Color="#292A2D"/>
    <SolidColorBrush x:Key="ToolbarBrush" Color="#35363A"/>
    <SolidColorBrush x:Key="TabHoverBrush" Color="#2B2C2F"/>
    <SolidColorBrush x:Key="TabSeparatorBrush" Color="#5F6368"/>
    <SolidColorBrush x:Key="TextBrush" Color="#E8EAED"/>
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#9AA0A6"/>
    <SolidColorBrush x:Key="IconBrush" Color="#C7C7C7"/>
    <SolidColorBrush x:Key="IconDisabledBrush" Color="#5F6368"/>
    <SolidColorBrush x:Key="ButtonHoverBrush" Color="#1FFFFFFF"/>
    <SolidColorBrush x:Key="ButtonPressedBrush" Color="#33FFFFFF"/>
    <SolidColorBrush x:Key="OmniboxBrush" Color="#202124"/>
    <SolidColorBrush x:Key="OmniboxHoverBrush" Color="#292A2D"/>
    <SolidColorBrush x:Key="OmniboxFocusBrush" Color="#202124"/>
    <SolidColorBrush x:Key="AccentBrush" Color="#A8C7FA"/>
    <SolidColorBrush x:Key="SelectionBrush" Color="#3E5F99"/>
    <SolidColorBrush x:Key="ToolbarSeparatorBrush" Color="#4A4C50"/>
    <SolidColorBrush x:Key="MenuBrush" Color="#292A2D"/>
    <SolidColorBrush x:Key="MenuHoverBrush" Color="#3C4043"/>
    <SolidColorBrush x:Key="MenuBorderBrush" Color="#3C4043"/>
    <SolidColorBrush x:Key="CloseHoverBrush" Color="#C42B1C"/>
    <SolidColorBrush x:Key="ContentBackgroundBrush" Color="#202124"/>
</ResourceDictionary>
